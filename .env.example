# EEVIS Application Configuration

# Database Configuration
DB_USER=eevis
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eevis

# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8081
SESSION_SECRET=

# TLS Configuration
USE_TLS=false
TLS_CERT_FILE=/path/to/cert.pem
TLS_KEY_FILE=/path/to/key.pem

# Environment (development, production)
APP_ENV=development
GITHUB_TOKEN=

# Hosted deployment (Railway)
DB_CREATE_DATABASE=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
